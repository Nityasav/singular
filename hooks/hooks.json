{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/on-prompt.js\"",
            "timeout": 8
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "(^|:)singular$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/on-expand.js\"",
            "timeout": 25
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/on-subagent.js\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
